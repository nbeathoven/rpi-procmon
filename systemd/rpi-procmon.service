[Unit]
Description=rpi-procmon daemon
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/default/rpi-procmon
ExecStart=/usr/local/bin/rpi-procmon
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
