# Copy to /etc/default/rpi-procmon
PROC_CONFIG_FILE=/etc/rpi-procmon/config.json
PROC_LOG_FILE=/var/log/rpi-procmon.log
PROC_STATE_FILE=/var/lib/rpi-procmon/state.json
PROC_API_LISTEN_ADDR=127.0.0.1:9645
PROC_API_READ_HEADER_TIMEOUT=5s
# Optional: enable admin control endpoints such as POST /api/v1/monitors/{id}/recover
# PROC_API_ADMIN_TOKEN=replace-with-long-random-token
